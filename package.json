await pool.query(`  ALTER TABLE notifications   ADD COLUMN IF NOT EXISTS job_id INTEGER  `);
 
await pool.query(`  CREATE TABLE IF NOT EXISTS reports (   id SERIAL PRIMARY KEY,   reporter_id INTEGER NOT NULL   REFERENCES users(id)   ON DELETE CASCADE,   post_id INTEGER   REFERENCES posts(id)   ON DELETE CASCADE,   reported_user_id INTEGER   REFERENCES users(id)   ON DELETE CASCADE,   job_id INTEGER,   reason TEXT NOT NULL,   created_at TIMESTAMPTZ DEFAULT NOW()   )  `);
 
