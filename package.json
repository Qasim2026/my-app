    /*
     * REELS
     */

    if (method === "GET" && path === "/new-reel") {
      return sendHtml(
        res,
        200,
        "Reel جدید",
        `
        <div class="card">
          <form method="post" action="/new-reel">

            <input
              name="video_url"
              type="url"
              placeholder="لینک ویدئو"
              required
            >

            <input
              name="thumbnail_url"
              type="url"
              placeholder="تصویر بندانگشتی، اختیاری"
            >

            <textarea
              name="caption"
              maxlength="5000"
              placeholder="کپشن #هشتگ"
            ></textarea>

            <input
              name="location"
              maxlength="200"
              placeholder="موقعیت"
            >

            <button class="blue full">
              انتشار Reel
            </button>
          </form>
        </div>
        `,
        user
      );
    }

    if (method === "POST" && path === "/new-reel") {
      const b = await readBody(req);

      const video = (b.get("video_url") || "").trim();
      const thumb = (b.get("thumbnail_url") || "").trim() || null;
      const caption = (b.get("caption") || "").trim();
      const location = (b.get("location") || "").trim() || null;

      if (video) {
        await pool.query(
          `INSERT INTO reels(
             user_id,caption,video_url,thumbnail_url,location
           )
           VALUES($1,$2,$3,$4,$5)`,
          [user.id,caption,video,thumb,location]
        );
      }

      return redirect(res,"/reels");
    }

    if (method === "GET" && path === "/reels") {
      const r = await pool.query(
        `SELECT
           r.*,
           u.name,
           u.username,
           u.avatar_url,
           (SELECT COUNT(*) FROM reel_likes
            WHERE reel_id=r.id)::int likes,
           (SELECT COUNT(*) FROM reel_comments
            WHERE reel_id=r.id)::int comments,
           (SELECT COUNT(*) FROM reel_views
            WHERE reel_id=r.id)::int views,
           EXISTS(
             SELECT 1 FROM reel_likes
             WHERE reel_id=r.id AND user_id=$1
           ) liked
         FROM reels r
         JOIN users u ON u.id=r.user_id
         ORDER BY r.created_at DESC
         LIMIT 50`,
        [user.id]
      );

      let content = `
        <div class="card">
          <h2>🎞️ Reels</h2>
          <a class="btn blue" href="/new-reel">
            ➕ Reel جدید
          </a>
        </div>
      `;

      for (const x of r.rows) {
        await pool.query(
          `INSERT INTO reel_views(reel_id,user_id)
           VALUES($1,$2)`,
          [x.id,user.id]
        );

        content += `
          <div class="card">

            <div class="row">
              ${avatar(x)}
              <div>
                <b>${escapeHtml(x.name)}</b>
                <div class="muted">
                  @${escapeHtml(x.username || "")}
                </div>
              </div>
            </div>

            <video
              class="media"
              controls
              preload="metadata"
              poster="${escapeHtml(x.thumbnail_url || "")}"
            >
              <source src="${escapeHtml(x.video_url)}">
            </video>

            <div class="text">
              ${escapeHtml(x.caption)}
            </div>

            <div class="stats">
              <span>❤️ ${x.likes}</span>
              <span>💬 ${x.comments}</span>
              <span>👁️ ${x.views}</span>
            </div>

            <div class="actions">
              ${button(
                `/reel-like?id=${x.id}`,
                x.liked ? "💔" : "❤️",
                "pink"
              )}

              ${
                x.user_id === user.id
                  ? button(
                      `/delete-reel?id=${x.id}`,
                      "🗑️ حذف",
                      "red"
                    )
                  : ""
              }

              <a class="btn gray" href="/report?reel=${x.id}">
                🚩
              </a>
            </div>

          </div>
        `;
      }

      return sendHtml(res,200,"Reels",content,user);
    }

    if (method === "POST" && path === "/reel-like") {
      const id = validId(parsed.searchParams.get("id"));

      const exists = await pool.query(
        `SELECT 1 FROM reel_likes
         WHERE user_id=$1 AND reel_id=$2`,
        [user.id,id]
      );

      if (exists.rowCount) {
        await pool.query(
          `DELETE FROM reel_likes
           WHERE user_id=$1 AND reel_id=$2`,
          [user.id,id]
        );
      } else {
        await pool.query(
          `INSERT INTO reel_likes(user_id,reel_id)
           VALUES($1,$2)
           ON CONFLICT DO NOTHING`,
          [user.id,id]
        );
      }

      return redirect(res,"/reels");
    }

    if (method === "POST" && path === "/delete-reel") {
      const id = validId(parsed.searchParams.get("id"));

      await pool.query(
        `DELETE FROM reels
         WHERE id=$1 AND user_id=$2`,
        [id,user.id]
      );

      return redirect(res,"/reels");
    }

    /*
     * REPORT
     */

    if (method === "GET" && path === "/report") {
      const post = validId(parsed.searchParams.get("post"));
      const comment = validId(parsed.searchParams.get("comment"));
      const reportedUser = validId(parsed.searchParams.get("user"));
      const reel = validId(parsed.searchParams.get("reel"));

      return sendHtml(
        res,
        200,
        "گزارش",
        `
        <div class="card">
          <form method="post" action="/report">

            <input type="hidden" name="post" value="${post || ""}">
            <input type="hidden" name="comment" value="${comment || ""}">
            <input type="hidden" name="user" value="${reportedUser || ""}">
            <input type="hidden" name="reel" value="${reel || ""}">

            <textarea
              name="reason"
              maxlength="2000"
              placeholder="دلیل گزارش"
              required
            ></textarea>

            <button class="red full">
              ارسال گزارش
            </button>
          </form>
        </div>
        `,
        user
      );
    }

    if (method === "POST" && path === "/report") {
      const b = await readBody(req);

      const postId = validId(b.get("post"));
      const commentId = validId(b.get("comment"));
      const reportedUser = validId(b.get("user"));
      const reelId = validId(b.get("reel"));

      const reason = (b.get("reason") || "").trim();

      if (reason) {
        await pool.query(
          `INSERT INTO reports(
             reporter_id,
             post_id,
             comment_id,
             reported_user_id,
             reason
           )
           VALUES($1,$2,$3,$4,$5)`,
          [
            user.id,
            postId,
            commentId,
            reportedUser,
            reason
          ]
        );
      }

      return redirect(res,"/");
    }

    /*
     * PROFILE EDIT
     */

    if (method === "GET" && path === "/edit-profile") {
      return sendHtml(
        res,
        200,
        "ویرایش پروفایل",
        `
        <div class="card">
          <form method="post" action="/edit-profile">

            <input
              name="name"
              maxlength="80"
              value="${escapeHtml(user.name)}"
              placeholder="نام"
              required
            >

            <input
              name="username"
              maxlength="30"
              value="${escapeHtml(user.username || "")}"
              placeholder="نام کاربری"
              required
            >

            <textarea
              name="bio"
              maxlength="500"
              placeholder="بیو"
            >${escapeHtml(user.bio || "")}</textarea>

            <input
              name="avatar_url"
              type="url"
              value="${escapeHtml(user.avatar_url || "")}"
              placeholder="لینک تصویر پروفایل"
            >

            <label>
              <input
                type="checkbox"
                name="private"
                ${user.is_private ? "checked" : ""}
              >
              حساب خصوصی
            </label>

            <button class="green full">
              ذخیره
            </button>

          </form>
        </div>
        `,
        user
      );
    }

    if (method === "POST" && path === "/edit-profile") {
      const b = await readBody(req);

      const name = (b.get("name") || "").trim();
      const username = (b.get("username") || "")
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9_]/g,"");

      const bio = (b.get("bio") || "").trim();
      const avatarUrl = (b.get("avatar_url") || "").trim() || null;
      const isPrivate = b.has("private");

      if (name && username) {
        const duplicate = await pool.query(
          `SELECT id FROM users
           WHERE username=$1 AND id<>$2`,
          [username,user.id]
        );

        if (!duplicate.rowCount) {
          await pool.query(
            `UPDATE users
             SET name=$1,
                 username=$2,
                 bio=$3,
                 avatar_url=$4,
                 is_private=$5
             WHERE id=$6`,
            [
              name,
              username,
              bio,
              avatarUrl,
              isPrivate,
              user.id
            ]
          );
        }
      }

      return redirect(res,"/profile");
    }

    /*
     * PASSWORD
     */

    if (method === "GET" && path === "/change-password") {
      return sendHtml(
        res,
        200,
        "تغییر رمز",
        `
        <div class="card">
          <form method="post" action="/change-password">
            <input
              name="old"
              type="password"
              placeholder="رمز فعلی"
              required
            >

            <input
              name="new"
              type="password"
              minlength="6"
              placeholder="رمز جدید"
              required
            >

            <button class="green full">
              تغییر رمز
            </button>
          </form>
        </div>
        `,
        user
      );
    }

    if (method === "POST" && path === "/change-password") {
      const b = await readBody(req);

      const oldPassword = b.get("old") || "";
      const newPassword = b.get("new") || "";

      if (newPassword.length < 6) {
        return sendHtml(
          res,
          400,
          "خطا",
          `<div class="card error">
             رمز جدید حداقل ۶ کاراکتر باشد.
           </div>`,
          user
        );
      }

      const valid = await pool.query(
        `SELECT id
         FROM users
         WHERE id=$1 AND password=$2`,
        [user.id,hashPassword(oldPassword)]
      );

      if (!valid.rowCount) {
        return sendHtml(
          res,
          400,
          "خطا",
          `<div class="card error">
             رمز فعلی اشتباه است.
           </div>`,
          user
        );
      }

      await pool.query(
        `UPDATE users
         SET password=$1
         WHERE id=$2`,
        [hashPassword(newPassword),user.id]
      );

      await pool.query(
        `DELETE FROM sessions
         WHERE user_id=$1`,
        [user.id]
      );

      return redirect(res,"/login",clearCookie());
    }

    /*
     * SETTINGS
     */

    if (method === "GET" && path === "/settings") {
      const r = await pool.query(
        `SELECT *
         FROM user_settings
         WHERE user_id=$1`,
        [user.id]
      );

      const s = r.rows[0] || {};

      return sendHtml(
        res,
        200,
        "تنظیمات",
        `
        <div class="card">
          <form method="post" action="/settings">

            <label>
              <input
                type="checkbox"
                name="notifications"
                ${s.notifications !== false ? "checked" : ""}
              >
              اعلان‌ها
            </label>

            <label>
              <input
                type="checkbox"
                name="message_notifications"
                ${s.message_notifications !== false ? "checked" : ""}
              >
              اعلان پیام
            </label>

            <label>
              <input
                type="checkbox"
                name="allow_messages"
                ${s.allow_messages !== false ? "checked" : ""}
              >
              اجازه پیام
            </label>

            <label>
              <input
                type="checkbox"
                name="allow_mentions"
                ${s.allow_mentions !== false ? "checked" : ""}
              >
              اجازه Mention
            </label>

            <label>
              <input
                type="checkbox"
                name="allow_tags"
                ${s.allow_tags !== false ? "checked" : ""}
              >
              اجازه Tag
            </label>

            <select name="theme">
              <option value="light" ${s.theme === "light" ? "selected" : ""}>
                روشن
              </option>
              <option value="dark" ${s.theme === "dark" ? "selected" : ""}>
                تاریک
              </option>
            </select>

            <button class="green full">
              ذخیره تنظیمات
            </button>
          </form>
        </div>
        `,
        user
      );
    }

    if (method === "POST" && path === "/settings") {
      const b = await readBody(req);

      await pool.query(
        `INSERT INTO user_settings(
           user_id,
           notifications,
           message_notifications,
           allow_messages,
           allow_mentions,
           allow_tags,
           theme
         )
         VALUES($1,$2,$3,$4,$5,$6,$7)
         ON CONFLICT(user_id)
         DO UPDATE SET
           notifications=EXCLUDED.notifications,
           message_notifications=EXCLUDED.message_notifications,
           allow_messages=EXCLUDED.allow_messages,
           allow_mentions=EXCLUDED.allow_mentions,
           allow_tags=EXCLUDED.allow_tags,
           theme=EXCLUDED.theme`,
        [
          user.id,
          b.has("notifications"),
          b.has("message_notifications"),
          b.has("allow_messages"),
          b.has("allow_mentions"),
          b.has("allow_tags"),
          b.get("theme") === "dark" ? "dark" : "light"
        ]
      );

      return redirect(res,"/settings");
    }

    /*
     * JOBS
     */

    if (method === "GET" && path === "/jobs") {
      const q = (parsed.searchParams.get("q") || "").trim();
      const city = (parsed.searchParams.get("city") || "").trim();

      const result = await pool.query(
        `SELECT
           j.*,
           u.name,
           u.username
         FROM jobs j
         JOIN users u ON u.id=j.user_id
         WHERE
           ($1='' OR
             j.title ILIKE $2 OR
             j.description ILIKE $2 OR
             j.category ILIKE $2)
           AND
           ($3='' OR j.city ILIKE $4)
         ORDER BY j.created_at DESC
         LIMIT 100`,
        [q,`%${q}%`,city,`%${city}%`]
      );

      let content = `
        <div class="card">
          <h2>💼 کاریابی</h2>

          <form method="get" action="/jobs">
            <input
              name="q"
              value="${escapeHtml(q)}"
              placeholder="عنوان یا دسته‌بندی"
            >

            <input
              name="city"
              value="${escapeHtml(city)}"
              placeholder="شهر"
            >

            <button class="blue">
              جستجو
            </button>
          </form>

          <div class="actions">
            <a class="btn green" href="/new-job">
              ➕ ثبت آگهی
            </a>
          </div>
        </div>
      `;

      for (const j of result.rows) {
        const saved = await pool.query(
          `SELECT 1 FROM saved_jobs
           WHERE user_id=$1 AND job_id=$2`,
          [user.id,j.id]
        );

        content += `
          <div class="job">
            <h3>${escapeHtml(j.title)}</h3>

            <div>
              👤 ${escapeHtml(j.name)}
            </div>

            <div>
              📂 ${escapeHtml(j.category || "عمومی")}
            </div>

            <div>
              📍 ${escapeHtml(j.city || "نامشخص")}
            </div>

            <div>
              🏢 ${escapeHtml(j.workplace || "")}
            </div>

            <div class="success">
              💰 ${escapeHtml(j.salary || "توافقی")}
            </div>

            <div class="text">
              ${escapeHtml(j.description)}
            </div>

            <div class="actions">
              <a class="btn blue" href="/job?id=${j.id}">
                جزئیات
              </a>

              ${button(
                `/save-job?id=${j.id}`,
                saved.rowCount ? "🔖 حذف ذخیره" : "🔖 ذخیره",
                "purple"
              )}

              ${
                j.user_id === user.id
                  ? `
                    <a class="btn" href="/edit-job?id=${j.id}">
                      ✏️ ویرایش
                    </a>
                    ${button(
                      `/delete-job?id=${j.id}`,
                      "🗑️ حذف",
                      "red"
                    )}
                  `
                  : ""
              }
            </div>
          </div>
        `;
      }

      if (!result.rowCount) {
        content += `
          <div class="card empty">
            آگهی‌ای پیدا نشد.
          </div>
        `;
      }

      return sendHtml(res,200,"کاریابی",content,user);
    }

    /*
     * NEW JOB
     */

    if (method === "GET" && path === "/new-job") {
      return sendHtml(
        res,
        200,
        "آگهی شغلی جدید",
        `
        <div class="card">
          <form method="post" action="/new-job">

            <input
              name="title"
              maxlength="200"
              placeholder="عنوان شغل"
              required
            >

            <input
              name="category"
              maxlength="100"
              placeholder="دسته‌بندی"
            >

            <input
              name="city"
              maxlength="100"
              placeholder="شهر"
            >

            <input
              name="workplace"
              maxlength="200"
              placeholder="محل کار"
            >

            <input
              name="salary"
              maxlength="100"
              placeholder="حقوق"
            >

            <textarea
              name="description"
              maxlength="10000"
              placeholder="توضیحات و شرایط"
              required
            ></textarea>

            <input
              name="contact"
              maxlength="500"
              placeholder="راه ارتباطی"
            >

            <button class="green full">
              انتشار آگهی
            </button>

          </form>
        </div>
        `,
        user
      );
    }

    if (method === "POST" && path === "/new-job") {
      const b = await readBody(req);

      const title = (b.get("title") || "").trim();
      const category = (b.get("category") || "").trim();
      const city = (b.get("city") || "").trim();
      const workplace = (b.get("workplace") || "").trim();
      const salary = (b.get("salary") || "").trim();
      const description = (b.get("description") || "").trim();
      const contact = (b.get("contact") || "").trim();

      if (title && description) {
        await pool.query(
          `INSERT INTO jobs(
             user_id,
             title,
             category,
             city,
             workplace,
             salary,
             description,
             contact
           )
           VALUES($1,$2,$3,$4,$5,$6,$7,$8)`,
          [
            user.id,
            title,
            category,
            city,
            workplace,
            salary,
            description,
            contact
          ]
        );
      }

      return redirect(res,"/jobs");
    }

    /*
     * JOB DETAILS
     */

    if (method === "GET" && path === "/job") {
      const id = validId(parsed.searchParams.get("id"));

      const r = await pool.query(
        `SELECT j.*,u.name,u.username
         FROM jobs j
         JOIN users u ON u.id=j.user_id
         WHERE j.id=$1`,
        [id]
      );

      if (!r.rowCount) {
        return sendHtml(
          res,
          404,
          "آگهی",
          `<div class="card empty">آگهی پیدا نشد.</div>`,
          user
        );
      }

      const j = r.rows[0];

      let content = `
        <div class="job">

          <h2>${escapeHtml(j.title)}</h2>

          <p>👤 ${escapeHtml(j.name)}</p>
          <p>📂 ${escapeHtml(j.category || "عمومی")}</p>
          <p>📍 ${escapeHtml(j.city || "نامشخص")}</p>
          <p>🏢 ${escapeHtml(j.workplace || "")}</p>
          <p>💰 ${escapeHtml(j.salary || "توافقی")}</p>

          <div class="text">
            ${escapeHtml(j.description)}
          </div>

          ${
            j.contact
              ? `<div class="notice">
                   📞 راه ارتباطی:
                   ${escapeHtml(j.contact)}
                 </div>`
              : ""
          }

          <div class="actions">
            ${button(
              `/save-job?id=${j.id}`,
              "🔖 ذخیره",
              "purple"
            )}

            ${
              j.user_id !== user.id
                ? `<a class="btn blue" href="/apply-job?id=${j.id}">
                     📨 درخواست
                   </a>`
                : ""
            }

            <a class="btn red" href="/report?job=${j.id}">
              🚩 گزارش
            </a>
          </div>

        </div>
      `;

      if (j.user_id === user.id) {
        const applications = await pool.query(
          `SELECT
             a.*,
             u.name,
             u.username
           FROM job_applications a
           JOIN users u ON u.id=a.applicant_id
           WHERE a.job_id=$1
           ORDER BY a.created_at DESC`,
          [id]
        );

        content += `<div class="card"><h3>📨 درخواست‌ها</h3>`;

        for (const a of applications.rows) {
          content += `
            <div class="comment">
              <b>${escapeHtml(a.name)}</b>
              <div class="text">
                ${escapeHtml(a.message || "")}
              </div>
              <div class="muted">
                وضعیت: ${escapeHtml(a.status)}
              </div>
            </div>
          `;
        }

        content += `</div>`;
      }

      return sendHtml(res,200,"جزئیات آگهی",content,user);
    }

    /*
     * APPLY JOB
     */

    if (method === "GET" && path === "/apply-job") {
      const id = validId(parsed.searchParams.get("id"));

      return sendHtml(
        res,
        200,
        "درخواست شغلی",
        `
        <div class="card">
          <form method="post" action="/apply-job?id=${id}">
            <textarea
              name="message"
              maxlength="5000"
              placeholder="پیام برای صاحب آگهی"
              required
            ></textarea>

            <button class="green full">
              ارسال درخواست
            </button>
          </form>
        </div>
        `,
        user
      );
    }

    if (method === "POST" && path === "/apply-job") {
      const id = validId(parsed.searchParams.get("id"));
      const b = await readBody(req);
      const message = (b.get("message") || "").trim();

      if (id && message) {
        const job = await pool.query(
          `SELECT user_id FROM jobs WHERE id=$1`,
          [id]
        );

        if (job.rowCount) {
          await pool.query(
            `INSERT INTO job_applications(
               job_id,applicant_id,message
             )
             VALUES($1,$2,$3)
             ON CONFLICT(job_id,applicant_id)
             DO UPDATE SET
               message=EXCLUDED.message,
               status='pending'`,
            [id,user.id,message]
          );

          await notify(
            job.rows[0].user_id,
            user.id,
            "job_application"
          );
        }
      }

      return redirect(res,`/job?id=${id}`);
    }

    if (method === "POST" && path === "/save-job") {
      const id = validId(parsed.searchParams.get("id"));

      const exists = await pool.query(
        `SELECT 1 FROM saved_jobs
         WHERE user_id=$1 AND job_id=$2`,
        [user.id,id]
      );

      if (exists.rowCount) {
        await pool.query(
          `DELETE FROM saved_jobs
           WHERE user_id=$1 AND job_id=$2`,
          [user.id,id]
        );
      } else {
        await pool.query(
          `INSERT INTO saved_jobs(user_id,job_id)
           VALUES($1,$2)
           ON CONFLICT DO NOTHING`,
          [user.id,id]
        );
      }

      return redirect(res,req.headers.referer || "/jobs");
    }

    /*
     * EDIT / DELETE JOB
     */

    if (method === "GET" && path === "/edit-job") {
      const id = validId(parsed.searchParams.get("id"));

      const r = await pool.query(
        `SELECT * FROM jobs
         WHERE id=$1 AND user_id=$2`,
        [id,user.id]
      );

      if (!r.rowCount) return redirect(res,"/jobs");

      const j = r.rows[0];

      return sendHtml(
        res,
        200,
        "ویرایش آگهی",
        `
        <div class="card">
          <form method="post" action="/edit-job?id=${id}">

            <input name="title"
              value="${escapeHtml(j.title)}"
              required>

            <input name="category"
              value="${escapeHtml(j.category || "")}">

            <input name="city"
              value="${escapeHtml(j.city || "")}">

            <input name="workplace"
              value="${escapeHtml(j.workplace || "")}">

            <input name="salary"
              value="${escapeHtml(j.salary || "")}">

            <textarea name="description"
              required>${escapeHtml(j.description)}</textarea>

            <input name="contact"
              value="${escapeHtml(j.contact || "")}">

            <button class="green">
              ذخیره
            </button>
          </form>
        </div>
        `,
        user
      );
    }

    if (method === "POST" && path === "/edit-job") {
      const id = validId(parsed.searchParams.get("id"));
      const b = await readBody(req);

      await pool.query(
        `UPDATE jobs
         SET title=$1,
             category=$2,
             city=$3,
             workplace=$4,
             salary=$5,
             description=$6,
             contact=$7,
             updated_at=NOW()
         WHERE id=$8 AND user_id=$9`,
        [
          (b.get("title") || "").trim(),
          (b.get("category") || "").trim(),
          (b.get("city") || "").trim(),
          (b.get("workplace") || "").trim(),
          (b.get("salary") || "").trim(),
          (b.get("description") || "").trim(),
          (b.get("contact") || "").trim(),
          id,
          user.id
        ]
      );

      return redirect(res,"/jobs");
    }

    if (method === "POST" && path === "/delete-job") {
      const id = validId(parsed.searchParams.get("id"));

      await pool.query(
        `DELETE FROM jobs
         WHERE id=$1 AND user_id=$2`,
        [id,user.id]
      );

      return redirect(res,"/jobs");
    }

    /*
     * CALLS
     * این بخش signaling را برای WebRTC آماده می‌کند.
     * خود تماس صوتی/تصویری به WebRTC در سمت Client نیاز دارد.
     */

    if (method === "POST" && path === "/call/start") {
      const receiverId = validId(
        parsed.searchParams.get("user")
      );

      const type =
        parsed.searchParams.get("type") === "video"
          ? "video"
          : "audio";

      if (!receiverId || receiverId === user.id) {
        return sendJson(res,400,{
          ok:false,
          error:"invalid_receiver"
        });
      }

      const r = await pool.query(
        `INSERT INTO active_calls(
           caller_id,
           receiver_id,
           call_type
         )
         VALUES($1,$2,$3)
         RETURNING id`,
        [user.id,receiverId,type]
      );

      await notify(
        receiverId,
        user.id,
        "call"
      );

      return sendJson(res,200,{
        ok:true,
        callId:r.rows[0].id,
        type
      });
    }

    if (method === "POST" && path === "/call/end") {
      const id = validId(
        parsed.searchParams.get("id")
      );

      await pool.query(
        `UPDATE active_calls
         SET status='ended',
             ended_at=NOW()
         WHERE id=$1
           AND (caller_id=$2 OR receiver_id=$2)`,
        [id,user.id]
      );

      return sendJson(res,200,{ok:true});
    }

    /*
     * AUDIO
     * فقط فایل/منبع مجاز.
     */

    if (method === "GET" && path === "/audio") {
      const r = await pool.query(
        `SELECT a.*,u.name
         FROM audio a
         JOIN users u ON u.id=a.user_id
         WHERE a.licensed=true
         ORDER BY a.created_at DESC
         LIMIT 50`
      );

      let content = `
        <div class="card">
          <h2>🎵 صداهای مجاز</h2>
          <p class="muted">
            فقط فایل‌ها و منابعی که اجازه استفاده از آن‌ها وجود دارد.
          </p>
        </div>
      `;

      for (const a of r.rows) {
        content += `
          <div class="card">
            <b>${escapeHtml(a.title)}</b>
            <div class="muted">
              ${escapeHtml(a.name)}
            </div>

            <audio controls style="width:100%;margin-top:10px">
              <source src="${escapeHtml(a.url)}">
            </audio>
          </div>
        `;
      }

      return sendHtml(res,200,"صدا",content,user);
    }

    /*
     * SEARCH HISTORY
     */

    if (method === "GET" && path === "/search-history") {
      const r = await pool.query(
        `SELECT *
         FROM search_history
         WHERE user_id=$1
         ORDER BY created_at DESC
         LIMIT 50`,
        [user.id]
      );

      let content = `
        <div class="card">
          <h2>🕘 جستجوهای اخیر</h2>

          ${button(
            "/search-history-clear",
            "🗑️ پاک کردن",
            "red"
          )}
        </div>
      `;

      for (const x of r.rows) {
        content += `
          <div class="card">
            🔎 ${escapeHtml(x.query)}
          </div>
        `;
      }

      return sendHtml(res,200,"تاریخچه جستجو",content,user);
    }

    if (method === "POST" && path === "/search-history-clear") {
      await pool.query(
        `DELETE FROM search_history
         WHERE user_id=$1`,
        [user.id]
      );

      return redirect(res,"/search-history");
    }

    /*
     * ACCOUNT DELETE
     */

    if (method === "POST" && path === "/delete-account") {
      await pool.query(
        `DELETE FROM users
         WHERE id=$1`,
        [user.id]
      );

      return redirect(res,"/login",clearCookie());
    }

    /*
     * PUBLIC PAGES
     */

    if (method === "GET" && path === "/about") {
      return sendHtml(
        res,
        200,
        "درباره برنامه",
        `
        <div class="card">
          <h2>درباره برنامه</h2>
          <p>
            یک پلتفرم اجتماعی فارسی با پست، پیام،
            دنبال‌کردن، استوری، Reel، کاریابی و امکانات
            تعاملی.
          </p>
        </div>
        `,
        user
      );
    }

    if (method === "GET" && path === "/rules") {
      return sendHtml(
        res,
        200,
        "قوانین",
        `
        <div class="card">
          <h2>قوانین استفاده</h2>
          <p>
            از انتشار محتوای غیرقانونی، آزاردهنده،
            فریبکارانه یا محتوایی که حقوق دیگران را
            نقض می‌کند خودداری کنید.
          </p>
        </div>
        `,
        user
      );
    }

    if (method === "GET" && path === "/privacy") {
      return sendHtml(
        res,
        200,
        "حریم خصوصی",
        `
        <div class="card">
          <h2>حریم خصوصی</h2>
          <p>
            اطلاعات حساب و تعاملات کاربران باید فقط
            در محدوده مجاز سیستم قابل دسترسی باشد.
          </p>
        </div>
        `,
        user
      );
    }

    /*
     * 404
     */

    return sendHtml(
      res,
      404,
      "صفحه پیدا نشد",
      `
      <div class="card empty">
        <h2>404</h2>
        <p>صفحه موردنظر پیدا نشد.</p>
        <a class="btn" href="/">بازگشت به خانه</a>
      </div>
      `,
      user
    );

  } catch (error) {
    console.error("REQUEST ERROR:", error);

    if (res.headersSent) {
      try {
        res.end();
      } catch {}
      return;
    }

    try {
      await sendHtml(
        res,
        500,
        "خطای سرور",
        `
        <div class="card">
          <div class="error">
            خطایی در اجرای درخواست رخ داد.
          </div>

          <p>
            اطلاعات فنی خطا به کاربر نمایش داده نمی‌شود.
          </p>

          <a class="btn" href="/">
            بازگشت به خانه
          </a>
        </div>
        `,
        user
      );
    } catch (secondError) {
      console.error(
        "ERROR PAGE FAILED:",
        secondError
      );

      if (!res.headersSent) {
        res.writeHead(500,{
          "Content-Type":"text/plain; charset=utf-8"
        });
      }

      res.end("Internal Server Error");
    }
  }
}

async function start() {
  try {
    await pool.query("SELECT NOW()");

    console.log("Database connection successful.");

    await initDatabase();

    const server = http.createServer(app);

    server.on(
      "clientError",
      (error,socket) => {
        console.error(
          "CLIENT ERROR:",
          error.message
        );

        try {
          socket.end(
            "HTTP/1.1 400 Bad Request\r\n\r\n"
          );
        } catch {}
      }
    );

    server.listen(
      PORT,
      "0.0.0.0",
      () => {
        console.log(
          `Server running on port ${PORT}`
        );
      }
    );

  } catch (error) {
    console.error(
      "STARTUP ERROR:",
      error
    );

    process.exit(1);
  }
}

process.on("unhandledRejection", error => {
  console.error(
    "UNHANDLED REJECTION:",
    error
  );
});

process.on("uncaughtException", error => {
  console.error(
    "UNCAUGHT EXCEPTION:",
    error
  );
});

start();
