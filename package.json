await pool.query(`  CREATE TABLE IF NOT EXISTS jobs (   id SERIAL PRIMARY KEY,   user_id INTEGER NOT NULL   REFERENCES users(id)   ON DELETE CASCADE,   title TEXT NOT NULL,   city TEXT,   salary TEXT,   description TEXT,   created_at TIMESTAMPTZ DEFAULT NOW(),   updated_at TIMESTAMPTZ DEFAULT NOW()   )  `);
 
