ass="muted">           ${escapeHtml(target.email)}         </div>          ${           target.bio             ? `               <p>                 ${escapeHtml(target.bio)}               </p>             `             : ""         }          <div class="profile-stats">            <div class="stat">             <strong>${s.posts}</strong>             پست           </div>            <a             class="stat"             href="/followers?id=${id}"           >             <strong>${s.followers}</strong>             دنبال‌کننده           </a>            <a             class="stat"             href="/following?id=${id}"           >             <strong>${s.following}</strong>             دنبال‌شده           </a>          </div>          ${           id !== user.id             ? `               <div class="actions">                  ${button(                   `/follow?id=${id}`,                   following.rowCount                     ? "➖ لغو دنبال"                     : "➕ دنبال کردن",                   "blue"                 )}                  ${                   blockedBy.rowCount                     ? `                       <div class="card error">                         این کاربر شما را مسدود کرده است.                       </div>                     `                     : blocked.rowCount                       ? button(                           `/unblock?id=${id}`,                           "🔓 رفع مسدودی",                           "green"                         )                       : `                         <a                           class="btn"                           href="/messages?user=${id}"                         >                           💬 پیام                         </a>                          ${button(                           `/block?id=${id}`,                           "🚫 مسدود کردن",                           "red"                         )}                       `                 }                  <a                   class=