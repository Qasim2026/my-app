async function messagesPage(req, res) {
  const user = await getCurrentUser(req);

  if (!user) {
    return redirect(res, "/login");
  }

  /*
    نکته مهم:
    به جای SELECT m.* و فرض کردن ساختار قدیمی،
    ستون‌ها را صریحاً انتخاب می‌کنیم.
    همچنین content با COALESCE ایمن می‌شود.
  */

  const result = await pool.query(
    `
      SELECT
        m.id,
        m.sender_id,
        m.receiver_id,
        COALESCE(m.content, '') AS content,
        m.created_at,
        m.read_at,
        sender.name AS sender_name,
        receiver.name AS receiver_name
      FROM messages m
      JOIN users sender
        ON sender.id = m.sender_id
      JOIN users receiver
        ON receiver.id = m.receiver_id
      WHERE m.sender_id = $1
         OR m.receiver_id = $1
      ORDER BY m.created_at DESC
      LIMIT 200
    `,
    [user.id]
  );

  const messages = result.rows
    .map(
      (m) => `
      <div class="message ${
        Number(m.sender_id) === Number(user.id)
          ? "mine"
          : ""
      }">

        <strong>
          ${
            Number(m.sender_id) === Number(user.id)
              ? "من"
              : escapeHtml(m.sender_name)
          }
        </strong>

        <div>
          ${escapeHtml(m.content)}
        </div>

        <small>
          ${new Date(m.created_at).toLocaleString("fa-IR")}
        </small>

      </div>
      `
    )
    .join("");

  const users = await pool.query(
    `
      SELECT id, name, email
      FROM users
      WHERE id <> $1
      ORDER BY name
      LIMIT 100
    `,
    [user.id]
  );

  const userOptions = users.rows
    .map(
      (u) =>
        `<option value="${u.id}">
          ${escapeHtml(u.name)} - ${escapeHtml(u.email)}
        </option>`
    )
    .join("");

  send(
    res,
    200,
    layout(
      "پیام‌ها",
      `
      <div class="card">

        <h2>💬 پیام‌ها</h2>

        ${
          messages ||
          "<p>هنوز پیامی وجود ندارد.</p>"
        }

      </div>

      <div class="card">

        <h3>ارسال پیام جدید</h3>

        <form method="POST" action="/messages/send">

          <select name="receiver_id" required>
            <option value="">
              انتخاب کاربر
            </option>

            ${userOptions}
          </select>

          <textarea
            name="content"
            placeholder="متن پیام..."
            required
          ></textarea>

          <button type="submit">
            ارسال پیام
          </button>

        </form>

      </div>
      `,
      user
    )
  );
}

async function parseForm(req) {
  const body = await new Promise((resolve, reject) => {
    let data = "";

    req.on("data", (chunk) => {
      data += chunk;

      if (data.length > 2 * 1024 * 1024) {
        reject(new Error("Form too large"));
        req.destroy();
      }
    });

    req.on("end", () => resolve(data));
    req.on("error", reject);
  });

  const params = new URLSearchParams(body);
  const result = {};

  for (const [key, value] of params.entries()) {
    result[key] = value;
  }

  return result;
}

async function handle(req, res) {
  const url = new URL(
    req.url,
    `http://${req.headers.host || "localhost"}`
  );

  const path = url.pathname;

  try {
    if (req.method === "GET" && path === "/") {
      return await home(req, res);
    }

    if (req.method === "GET" && path === "/login") {
      return loginPage(res);
    }

    if (req.method === "GET" && path === "/register") {
      return registerPage(res);
    }

    if (req.method === "POST" && path === "/register") {
      const body = await parseForm(req);

      const name = String(body.name || "").trim();
      const email = String(body.email || "")
        .trim()
        .toLowerCase();
      const password = String(body.password || "");

      if (!name || !email || !password) {
        return registerPage(res, "همه فیلدها الزامی هستند.");
      }

      if (password.length < 6) {
        return registerPage(
          res,
          "رمز عبور باید حداقل ۶ کاراکتر باشد."
        );
      }

      try {
        await pool.query(
          `
            INSERT INTO users
            (name, email, password)
            VALUES ($1, $2, $3)
          `,
          [name, email, hashPassword(password)]
        );

        return redirect(res, "/login");
      } catch (error) {
        console.error("REGISTER ERROR:", error);

        return registerPage(
          res,
          "این ایمیل قبلاً ثبت شده یا خطایی رخ داده است."
        );
      }
    }

    if (req.method === "POST" && path === "/login") {
      const body = await parseForm(req);

      const email = String(body.email || "")
        .trim()
        .toLowerCase();

      const password = String(body.password || "");

      const result = await pool.query(
        `
          SELECT *
          FROM users
          WHERE email = $1
          LIMIT 1
        `,
        [email]
      );

      const user = result.rows[0];

      if (
        !user ||
        user.password !== hashPassword(password)
      ) {
        return loginPage(
          res,
          "ایمیل یا رمز عبور اشتباه است."
        );
      }

      const token = crypto.randomBytes(32).toString("hex");

      await pool.query(
        `
          INSERT INTO sessions
          (user_id, token)
          VALUES ($1, $2)
        `,
        [user.id, token]
      );

      res.writeHead(302, {
        Location: "/",
        "Set-Cookie": `session=${encodeURIComponent(
          token
        )}; HttpOnly; Path=/; SameSite=Lax`,
      });

      return res.end();
    }

    if (req.method === "GET" && path === "/logout") {
      const cookies = parseCookies(req);

      if (cookies.session) {
        await pool.query(
          `DELETE FROM sessions WHERE token = $1`,
          [cookies.session]
        );
      }

      res.writeHead(302, {
        Location: "/login",
        "Set-Cookie":
          "session=; HttpOnly; Path=/; Max-Age=0; SameSite=Lax",
      });

      return res.end();
    }

    if (req.method === "POST" && path === "/posts") {
      const user = await getCurrentUser(req);

      if (!user) {
        return redirect(res, "/login");
      }

      const body = await parseForm(req);

      const content = String(body.content || "").trim();
      const imageUrl = String(body.image_url || "").trim();

      if (!content && !imageUrl) {
        return redirect(res, "/");
      }

      await pool.query(
        `
          INSERT INTO posts
          (user_id, content, image_url)
          VALUES ($1, $2, $3)
        `,
        [user.id, content, imageUrl]
      );

      return redirect(res, "/");
    }

    if (req.method === "POST" && path === "/like") {
      const user = await getCurrentUser(req);

      if (!user) {
        return redirect(res, "/login");
      }

      const body = await parseForm(req);
      const postId = Number(body.post_id);

      if (!Number.isInteger(postId)) {
        return redirect(res, "/");
      }

      const exists = await pool.query(
        `
          SELECT id
          FROM likes
          WHERE user_id = $1
            AND post_id = $2
        `,
        [user.id, postId]
      );

      if (exists.rowCount) {
        await pool.query(
          `
            DELETE FROM likes
            WHERE user_id = $1
              AND post_id = $2
          `,
          [user.id, postId]
        );
      } else {
        await pool.query(
          `
            INSERT INTO likes
            (user_id, post_id)
            VALUES ($1, $2)
            ON CONFLICT DO NOTHING
          `,
          [user.id, postId]
        );
      }

      return redirect(res, "/");
    }

    if (req.method === "POST" && path === "/save") {
      const user = await getCurrentUser(req);

      if (!user) {
        return redirect(res, "/login");
      }

      const body = await parseForm(req);
      const postId = Number(body.post_id);

      if (!Number.isInteger(postId)) {
        return redirect(res, "/");
      }

      const exists = await pool.query(
        `
          SELECT id
          FROM saved_posts
          WHERE user_id = $1
            AND post_id = $2
        `,
        [user.id, postId]
      );

      if (exists.rowCount) {
        await pool.query(
          `
            DELETE FROM saved_posts
            WHERE user_id = $1
              AND post_id = $2
          `,
          [user.id, postId]
        );
      } else {
        await pool.query(
          `
            INSERT INTO saved_posts
            (user_id, post_id)
            VALUES ($1, $2)
            ON CONFLICT DO NOTHING
          `,
          [user.id, postId]
        );
      }

      return redirect(res, "/");
    }

    if (
      req.method === "GET" &&
      path === "/messages"
    ) {
      return await messagesPage(req, res);
    }

    if (
      req.method === "POST" &&
      path === "/messages/send"
    ) {
      const user = await getCurrentUser(req);

      if (!user) {
        return redirect(res, "/login");
      }

      const body = await parseForm(req);

      const receiverId = Number(body.receiver_id);
      const content = String(body.content || "").trim();

      if (
        !Number.isInteger(receiverId) ||
        receiverId <= 0 ||
        !content
      ) {
        return redirect(res, "/messages");
      }

      if (receiverId === Number(user.id)) {
        return redirect(res, "/messages");
      }

      const receiver = await pool.query(
        `
          SELECT id
          FROM users
          WHERE id = $1
          LIMIT 1
        `,
        [receiverId]
      );

      if (!receiver.rowCount) {
        return redirect(res, "/messages");
      }

      await pool.query(
        `
          INSERT INTO messages
          (sender_id, receiver_id, content)
          VALUES ($1, $2, $3)
        `,
        [user.id, receiverId, content]
      );

      return redirect(res, "/messages");
    }

    if (req.method === "GET" && path === "/health") {
      return json(res, 200, {
        ok: true,
        service: "social-platform",
        database: true,
        time: new Date().toISOString(),
      });
    }

    return send(
      res,
      404,
      layout(
        "404",
        `
        <div class="card">
          <h2>صفحه پیدا نشد</h2>
          <a href="/">بازگشت به خانه</a>
        </div>
        `
      )
    );
  } catch (error) {
    console.error("REQUEST ERROR:", error);

    if (!res.headersSent) {
      return send(
        res,
        500,
        layout(
          "خطای سرور",
          `
          <div class="card">
            <div class="error">
              خطای داخلی سرور رخ داد.
            </div>

            <a href="/">بازگشت به صفحه اصلی</a>
          </div>
          `
        )
      );
    }

    res.end();
  }
}

async function start() {
  try {
    await initDatabase();

    const server = http.createServer(handle);

    server.listen(PORT, "0.0.0.0", () => {
      console.log(
        `Server running on port ${PORT}`
      );
    });
  } catch (error) {
    console.error("STARTUP ERROR:", error);
    process.exit(1);
  }
}

start();
