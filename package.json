    );  

  const b = await readBody(req);  

  const content =  
    String(b.get("content") || "")  
      .trim()  
      .slice(0, 5000);  

  if (  
    otherId &&  
    otherId !== user.id &&  
    content  
  ) {  
    const blocked =  
      await pool.query(  
        `  
          SELECT 1  
          FROM blocks  
          WHERE  
            (  
              blocker_id=$1  
              AND blocked_id=$2  
            )  
            OR  
            (  
              blocker_id=$2  
              AND blocked_id=$1  
            )  
        `,  
        [user.id, otherId]  
      );  

    if (!blocked.rowCount) {  
      await pool.query(  
        `  
          INSERT INTO messages  
          (  
            sender_id,  
            receiver_id,  
            content  
          )  
          VALUES($1,$2,$3)  
        `,  
        [  
          user.id,  
          otherId,  
          content  
        ]  
      );  

      await pool.query(  
        `  
          INSERT INTO notifications  
          (  
            user_id,  
            actor_id,  
            type  
          )  
          VALUES($1,$2,'message')  
        `,  
        [  
          otherId,  
          user.id  
        ]  
      );  
    }  
  }  

  return redirect(  
    res,`/messages?user=${otherId}`  
  );  
}  

