async function initDatabase() { await pool.query(`  CREATE TABLE IF NOT EXISTS users (   id SERIAL PRIMARY KEY,   name TEXT NOT NULL,   email TEXT UNIQUE NOT NULL,   password TEXT NOT NULL,   bio TEXT DEFAULT '',   avatar_url TEXT,   theme TEXT DEFAULT 'light',   created_at TIMESTAMPTZ DEFAULT NOW()   )  `);
 
