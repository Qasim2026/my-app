async function home(req, res) {
  const user = await getCurrentUser(req);

  const result = await pool.query(`
    SELECT
      p.*,
      u.name,
      u.email,
      COUNT(DISTINCT l.id) AS likes_count,
      COUNT(DISTINCT c.id) AS comments_count
    FROM posts p
    JOIN users u ON u.id = p.user_id
    LEFT JOIN likes l ON l.post_id = p.id
    LEFT JOIN comments c ON c.post_id = p.id
    GROUP BY p.id, u.id
    ORDER BY p.created_at DESC
    LIMIT 100
  `);

  const posts = result.rows
    .map(
      (p) => `
      <div class="card post">

        <div class="post-user">
          ${escapeHtml(p.name)}
        </div>

        <div>
          ${escapeHtml(p.content)}
        </div>

        ${
          p.image_url
            ? `<img src="${escapeHtml(p.image_url)}" alt="post">`
            : ""
        }

        <div>
          ❤️ ${p.likes_count}
          &nbsp;
          💬 ${p.comments_count}
        </div>

        ${
          user
            ? `
          <div class="actions">

            <form method="POST" action="/like">
              <input type="hidden" name="post_id" value="${p.id}">
              <button type="submit">❤️ پسندیدن</button>
            </form>

            <form method="POST" action="/save">
              <input type="hidden" name="post_id" value="${p.id}">
              <button type="submit">🔖 ذخیره</button>
            </form>

          </div>
          `
            : ""
        }

      </div>
      `
    )
    .join("");

  const createPost = user
    ? `
      <div class="card">
        <h3>➕ انتشار پست جدید</h3>

        <form method="POST" action="/posts">
          <textarea
            name="content"
            placeholder="چه چیزی می‌خواهی منتشر کنی؟"
            required
          ></textarea>

          <input
            name="image_url"
            placeholder="لینک تصویر، در صورت نیاز"
          >

          <button type="submit">
            انتشار پست
          </button>
        </form>
      </div>
    `
    : "";

  send(
    res,
    200,
    layout(
      "خانه",
      createPost +
        `
        <h2>پست‌های جدید</h2>
        ${posts || "<div class='card'>هنوز پستی وجود ندارد.</div>"}
        `,
      user
    )
  );
}

