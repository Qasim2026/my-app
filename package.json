const http = require("http");
const crypto = require("crypto");
const { Pool } = require("pg");

const PORT = Number(process.env.PORT || 10000);
const DATABASE_URL = process.env.DATABASE_URL;

if (!DATABASE_URL) {
console.error("DATABASE_URL is not set.");
process.exit(1);
}

const pool = new Pool({
connectionString: DATABASE_URL,
ssl: { rejectUnauthorized: false },
connectionTimeoutMillis: 10000,
idleTimeoutMillis: 30000,
max: 10
});

/* =========================================================
ابزارهای عمومی
========================================================= */

function escapeHtml(value) {
return String(value ?? "")
.replace(/&/g, "&")
.replace(/</g, "<")
.replace(/>/g, ">")
.replace(/"/g, """)
.replace(/'/g, "'");
}

function escapeAttr(value) {
return escapeHtml(value);
}

function token() {
return crypto.randomBytes(32).toString("hex");
}

function hashPassword(password) {
const salt = crypto.randomBytes(16).toString("hex");

const derived = crypto.scryptSync(
String(password),
salt,
64
).toString("hex");

return scrypt$${salt}$${derived};
}

function verifyPassword(password, stored) {
if (!stored) return false;

/*
پشتیبانی از رمزهای نسخه قبلی که SHA-256 بودند.
بنابراین کاربران قبلی مجبور نیستند حساب جدید بسازند.
*/
if (/^[a-f0-9]{64}$/i.test(stored)) {
const legacy = crypto
.createHash("sha256")
.update(String(password))
.digest("hex");

return crypto.timingSafeEqual(  
  Buffer.from(legacy),  
  Buffer.from(stored)  
);

}

const parts = String(stored).split("$");

if (
parts.length !== 3 ||
parts[0] !== "scrypt"
) {
return false;
}

const salt = parts[1];
const expected = parts[2];

try {
const actual = crypto.scryptSync(
String(password),
salt,
64
).toString("hex");

if (actual.length !== expected.length) {  
  return false;  
}  

return crypto.timingSafeEqual(  
  Buffer.from(actual),  
  Buffer.from(expected)  
);

} catch {
return false;
}
}

function parseCookies(req) {
const cookies = {};
const header = req.headers.cookie || "";

for (const item of header.split(";")) {
const i = item.indexOf("=");

if (i < 0) continue;  

const key = item.slice(0, i).trim();  
const value = item.slice(i + 1).trim();  

try {  
  cookies[key] = decodeURIComponent(value);  
} catch {  
  cookies[key] = value;  
}

}

return cookies;
}

function sessionCookie(id) {
return [
sessionId=${encodeURIComponent(id)},
"HttpOnly",
"Path=/",
"SameSite=Lax",
"Max-Age=2592000"
].join("; ");
}

function themeCookie(theme) {
return [
theme=${theme === "dark" ? "dark" : "light"},
"Path=/",
"SameSite=Lax",
"Max-Age=31536000"
].join("; ");
}

function clearCookie(name) {
return ${name}=; HttpOnly; Path=/; SameSite=Lax; Max-Age=0;
}

function redirect(res, location, cookies = []) {
const headers = {
Location: location
};

if (!Array.isArray(cookies)) {
cookies = [cookies];
}

if (cookies.length) {
headers["Set-Cookie"] = cookies.filter(Boolean);
}

res.writeHead(302, headers);
res.end();
}

function safeUrl(value) {
const valueString = String(value || "").trim();

if (!valueString) return null;

try {
const parsed = new URL(valueString);

if (  
  parsed.protocol !== "http:" &&  
  parsed.protocol !== "https:"  
) {  
  return null;  
}  

return parsed.toString();

} catch {
return null;
}
}

function parseId(value) {
const id = Number(value);

if (!Number.isInteger(id) || id <= 0) {
return null;
}

return id;
}

function formatDate(value) {
try {
return new Date(value).toLocaleString("fa-IR");
} catch {
return "";
}
}

function truncate(value, max = 500) {
return String(value || "").slice(0, max);
}

function readBody(req) {
return new Promise((resolve, reject) => {
let data = "";
let finished = false;

req.on("data", chunk => {  
  if (finished) return;  

  data += chunk.toString();  

  if (Buffer.byteLength(data, "utf8") > 4 * 1024 * 1024) {  
    finished = true;  
    reject(new Error("Request too large"));  
    req.destroy();  
  }  
});  

req.on("end", () => {  
  if (finished) return;  

  try {  
    resolve(new URLSearchParams(data));  
  } catch (error) {  
    reject(error);  
  }  
});  

req.on("error", reject);

});
}

function avatar(name, image = null, size = 48) {
if (image) {
return   <img   src="${escapeAttr(image)}"   class="avatar-img"   style="width:${size}px;height:${size}px"   alt="پروفایل"   loading="lazy"   >  ;
}

const first =
String(name || "?").trim().slice(0, 1) || "?";

return   <div   class="avatar"   style="width:${size}px;height:${size}px"   >   ${escapeHtml(first)}   </div>  ;
}

function button(action, text, cls = "") {
return   <form method="post" action="${escapeAttr(action)}" class="inline">   <button class="${escapeAttr(cls)}">${text}</button>   </form>  ;
}

function mediaHtml(url) {
if (!url) return "";

const safe = safeUrl(url);

if (!safe) return "";

const lower = safe.toLowerCase();

if (
lower.endsWith(".mp4") ||
lower.endsWith(".webm") ||
lower.endsWith(".ogg") ||
lower.includes(".mp4?") ||
lower.includes(".webm?")
) {
return   <video   class="media"   controls   preload="metadata"   src="${escapeAttr(safe)}"   ></video>  ;
}

return   <a   href="${escapeAttr(safe)}"   target="_blank"   rel="noopener noreferrer"   >   <img   class="media"   src="${escapeAttr(safe)}"   alt="رسانه پست"   loading="lazy"   >   </a>  ;
}

function postTextHtml(text) {
let output = escapeHtml(text);

output = output.replace(
/(^|\s)(#[\p{L}\p{N}_]+)/gu,
'$1<a href="/hashtag?tag=$2">$2</a>'
);

return output.replace(/\n/g, "<br>");
}

function pageError(status, title, message) {
return   <div class="card center">   <div class="error-number">${status}</div>   <h2>${escapeHtml(title)}</h2>   <p class="muted">${escapeHtml(message)}</p>   <a class="btn blue" href="/">🏠 بازگشت به خانه</a>   </div>  ;
}

/* =========================================================
کاربر و Session
========================================================= */

async function getUser(req) {
const sessionId = parseCookies(req).sessionId;

if (!sessionId) return null;

const result = await pool.query(
  SELECT   u.id,   u.name,   u.email,   u.bio,   u.avatar_url,   u.theme,   s.session_id   FROM sessions s   JOIN users u ON u.id=s.user_id   WHERE s.session_id=$1   AND s.expires_at > NOW()  ,
[sessionId]
);

if (!result.rowCount) return null;

await pool.query(
  UPDATE sessions   SET last_seen=NOW()   WHERE session_id=$1  ,
[sessionId]
);

return result.rows[0];
}

async function createSession(req, userId) {
const id = token();

const userAgent =
String(req.headers["user-agent"] || "").slice(0, 500);

const ip =
String(
req.headers["x-forwarded-for"] ||
req.socket.remoteAddress ||
""
).slice(0, 100);

await pool.query(
  INSERT INTO sessions   (   session_id,   user_id,   user_agent,   ip_address,   expires_at,   last_seen   )   VALUES   ($1,$2,$3,$4,NOW()+INTERVAL '30 days',NOW())  ,
[id, userId, userAgent, ip]
);

return id;
}

async function destroySession(req) {
const sid = parseCookies(req).sessionId;

if (!sid) return;

await pool.query(
  DELETE FROM sessions   WHERE session_id=$1  ,
[sid]
);
}

