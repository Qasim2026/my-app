if (  
  method === "GET" &&  
  path === "/jobs"  
) {  
  const q =  
    String(  
      url.searchParams.get("q") || ""  
    ).trim();  

  const city =  
    String(  
      url.searchParams.get("city") || ""  
    ).trim();  

  const minSalary =  
    String(  
      url.searchParams.get("min_salary") || ""  
    ).trim();  

  const params = [];  
  const conditions = [];  

  let index = 1;  

  if (q) {  
    conditions.push(`  
      (  
        j.title ILIKE $${index}  
        OR j.description ILIKE $${index}  
        OR j.city ILIKE $${index}  
      )  
    `);  

    params.push(`%${q}%`);  
    index++;  
  }  

  if (city) {  
    conditions.push(  
      `j.city ILIKE $${index}`  
    );  

    params.push(`%${city}%`);  
    index++;  
  }  

  /*  
    فیلتر حداقل حقوق فقط وقتی مقدار عددی  
    قابل تبدیل به عدد باشد.  
  */  
  const minNumber =  
    Number(minSalary);  

  if (  
    minSalary &&  
    Number.isFinite(minNumber)  
  ) {  
    conditions.push(`  
      NULLIF(  
        regexp_replace(  
          j.salary,  
          '[^0-9]',  
          '',  
          'g'  
        ),  
        ''  
      )::numeric >= $${index}  
    `);  

    params.push(minNumber);  
    index++;  
  }  

  const where =  
    conditions.length  
      ? `WHERE ${conditions.join(" AND ")}`  
      : "";  

  const jobs =  
    await pool.query(  
      `  
        SELECT  
          j.*,  
          u.name,  
          u.avatar_url  

        FROM jobs j  

        JOIN users u  
        ON u.id=j.user_id  

        ${where}  

        ORDER BY j.created_at DESCLIMIT 100  
      `,  
      params  
    );  

  let content = `  
    <div class="card">  

      <h2>💼 کاریابی</h2>  

      <a  
        class="btn green full"  
        href="/new-job"  
      >  
        ➕ ثبت آگهی شغلی  
      </a>  

    </div>  

    <div class="card">  

      <h3>🔎 جستجو و فیلتر</h3>  

      <form  
        method="get"  
        action="/jobs"  
      >  

        <input  
          name="q"  
          value="${escapeAttr(q)}"  
          placeholder="عنوان یا توضیحات"  
        >  

        <div class="filter-row">  

          <input  
            name="city"  
            value="${escapeAttr(city)}"  
            placeholder="شهر"  
          >  

          <input  
            name="min_salary"  
            type="number"  
            min="0"  
            value="${escapeAttr(minSalary)}"  
            placeholder="حداقل حقوق"  
          >  

        </div>  

        <button class="blue full">  
          🔎 جستجو  
        </button>  

      </form>  

    </div>  
  `;  

  for (const j of jobs.rows) {  
    content += `  
      <div class="job">  

        <h3>  
          ${escapeHtml(j.title)}  
        </h3>  

        <div>  
          👤  
          <a href="/user?id=${j.user_id}">  
            ${escapeHtml(j.name)}  
          </a>  
        </div>  

        <div>  
          📍  
          ${escapeHtml(  
            j.city || "نامشخص"  
          )}  
        </div>  

        <div class="success">  
          💰  
          ${escapeHtml(  
            j.salary || "توافقی"  
          )}  
        </div>  

        <div class="text">  
          ${escapeHtml(  
            truncate(  
              j.description,  
              500  
            )  
          )}  
        </div>  

        <div class="muted">  
          ${formatDate(j.created_at)}  
        </div><a  
          class="btn blue"  
          href="/job?id=${j.id}"  
        >  
          مشاهده جزئیات  
        </a>  

      </div>  
    `;  
  }  

  if (!jobs.rowCount) {  
    content += `  
      <div class="card center muted">  
        آگهی‌ای پیدا نشد.  
      </div>  
    `;  
  }  

  return sendHtml(  
    res,  
    200,  
    "کاریابی",  
    content,  
    user,  
    req  
  );  
}  

