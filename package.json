جود ندارد."         ),         user,         req       );     }      const p = result.rows[0];      const comments =       await pool.query(         `           SELECT             c.*,             u.name,             u.avatar_url            FROM comments c            JOIN users u           ON u.id=c.user_id            WHERE c.post_id=$1            ORDER BY c.created_at ASC         `,         [id]       );      let content = `       <article class="card post">          <div class="post-header">            ${avatar(             p.name,             p.avatar_url           )}            <div class="user-info">              <a href="/user?id=${p.user_id}">               <strong>                 ${escapeHtml(p.name)}               </strong>             </a>              <span class="muted">               ${formatDate(p.created_at)}             </span>            </div>          </div>          <div class="post-content">           ${postTextHtml(p.content)}         </div>          ${mediaHtml(p.media_url)}          <div class="post-stats">           ❤️ ${p.likes}           &nbsp;&nbsp;           💬 ${p.comments}         </div>          <div class="actions">            ${button(             `/like?id=${p.id}`,             "❤️ لایک",             "pink"           )}            ${button(             `/save?id=${p.id}`,             "🔖 ذخیره",             "purple"           )}            ${             p.user_id === user.id               ? `                 <a                   class="btn"                   href="/edit-post?id=${p.id}"                 >                   ✏️ ویرایش                 </a>               `               : ""           }            <a             class="btn gray"             href="/report?post=${p.id}"           >             🚩 گزارش           </a>          </div>        </article>        <div class="card">          <h3>💬 نظرات</h3>          <form           method="post"           action="/comment?id=${p.id}"         >            <textarea             name="content"             placeholder="نظر خودت را بنویس..."             required             maxlength="3000"           ></textarea>            <button class="blue">             📤 ارسال نظر           </button>          </form>        </div>     `;      for (const c of comments.rows) {       content += `         <div class="card comment">            <div class="user-row">              ${avatar(               c.name,               c.avatar_url,               40             )}              <div class="user-info">                <a href="/user?id=${c.user_id}">                 <strong>                   ${escapeHtml(c.name)}                 </strong>               </a>                <span class="muted">                 ${formatDate(c.created_at)}               </span>              </div>            </div>            <div class="post-content">             ${escapeHtml(c.content)}           </div>            ${             c.user_id === user.id ||             p.user_id === user.id               ? button(                   `/delete-comment?id=${c.id}`,                   "🗑️ حذف",                   "red"                 )               : ""           }          </div>       `;     }      return sendHtml(       res,       200,       "پست",       content,       user,       req     );   }    /* =====================================================      ثبت کامنت   ===================================================== */    if (     method === "POST" &&     path === "/comment"   ) {     const id =       parseId(         url.searchParams.get("id")       );      const b = await readBody(req);      const content =       String(b.get("content") || "")         .trim()         .slice(0, 3000);      if (id && content) {       const post =         await pool.query(           `             SELECT user_id             FROM posts             WHERE id=$1           `,           [id]         );        if (post.rowCount) {         await pool.query(           `             INSERT INTO comments