n sendHtml(         res,         400,         "خطا",         `           <div class="card center">             <h3 class="error">               این ایمیل قبلاً ثبت شده است.             </h3>             <a class="btn blue" href="/login">               ورود             </a>           </div>         `,         null,         req       );     }      const result = await pool.query(       `         INSERT INTO users         (           name,           email,           password         )         VALUES($1,$2,$3)         RETURNING id       `,       [         name,         email,         hashPassword(password)       ]     );      const sessionId =       await createSession(         req,         result.rows[0].id       );      return redirect(       res,       "/",       sessionCookie(sessionId)     );   }    /* =====================================================      همه مسیرهای بعدی نیاز به ورود دارند   ===================================================== */    if (!user) {     return redirect(res, "/login");   }    /* =====================================================      خروج   ===================================================== */    if (     method === "POST" &&     path === "/logout"   ) {     await destroySession(req);      return redirect(       res,       "/login",       [         clearCookie("sessionId")       ]     );   }    /* =====================================================      تغییر حالت روشن / تاریک   ===================================================== */    if (     method === "POST" &&     path === "/theme"   ) {     const b = await readBody(req);      const theme =       b.get("theme") === "dark"         ? "dark"         : "light";      await pool.query(       `         UPDATE users         SET theme=$1         WHERE id=$2       `,       [theme, user.id]     );      return redirect(       res,       req.headers.referer || "/profile",       themeCookie(theme)     );   }    /* =====================================================      خانه   ===================================================== */    if (     method === "GET" &&     path === "/"   ) {     const posts = await pool.query(       `         SELECT           p.*,           u.name,           u.avatar_url,            (             SELECT COUNT(*)             FROM likes l             WHERE l.post_id=p.id           )::int AS likes,            (             SELECT COUNT(*)             FROM comments c             WHERE c.post_id=p.id           )::int AS comments,            EXISTS(             SELECT 1             FROM likes l             WHERE l.user_id=$1               AND l.post_id=p.id           ) AS liked,            EXISTS(             SELECT 1             FROM saved_posts s             WHERE s.user_id=$1               AND s.post_id=p.id           ) AS saved          FROM posts p          JOIN users u         ON u.id=p.user_id          WHERE NOT EXISTS(           SELECT 1           FROM blocks b           WHERE             (               b.blocker_id=$1               AND b.blocked_id=p.user_id             )             OR             (               b.blocker_id=p.user_id               AND b.blocked_id=$1             )         )          ORDER BY p.created_at DESC          LIMIT 50       `,       [user.id]     );      let content = `       <div class="card">          <div class="user-row">            ${avatar(             user.name,             user.avatar_url           )}            <div class="user-info">              <strong>               ${escapeHtml(user.name)}             </strong>              <span class="muted">               ${escapeHtml(user.email)}             </span>            </div>          </div>          <div class="actions">            <a             class="btn blue"             href="/new-post"           >             ➕ انتشار پست           </a>            <a             class="btn green"             href="/jobs"           >             💼 کاریابی           </a>          </div>        </div>     `;      for (const post of posts.rows) {       content += `         <article class="card post">            <div class="post-header">              ${avatar(               post.name,               post.avatar_url             )}              <div class="user-info">                <a href="/user?id=${post.user_id}">                 <strong>                   ${escapeHtml(post.name)}                 </strong>               </a>                <span class="muted">                 ${formatDate(post.created_at)}               </span>              </div>            </div>            <div class="post-content">             ${postTextHtml(post.content)}           </div>            ${mediaHtml(post.media_url)}            <div class="post-stats">              <span>               ❤️ ${post.likes}             </span>              <span>               💬 ${post.comments}             </span>            </div>            <div class="actions">              ${button(               `/like?id=${post.id}`,               post.liked                 ? "💔 لغو لایک"                 : "❤️ لایک",               "pink"             )}              ${button(               `/save?id=${post.id}`,               post.saved                 ? "🔖 حذف ذخیره"                 : "🔖 ذخیره",               "purple"             )}              <a               class="btn blue"               href="/post?id=${post.id}"             >               💬 نظر             </a>              ${               post.user_id === user.id                 ? `                   <a                     class="btn"                     href="/edit-post?id=${post.id}"                   >                     ✏️ ویرایش                   </a>                    ${button(                     `/delete-post?id=${post.id}`,                     "🗑️ حذف",                     "red"                   )}                 `                 : ""             }              <a               class="btn gray"               href="/report?post=${post.id}"             >               🚩 گزارش             </a>            </div>          </article>       `;     }      if (!posts.rowCount) {       content += `         <div class="card center">           <h3>هنوز پستی منتشر نشده است.</h3>           <p class="muted">             اولین پست را منتشر کن.           </p>           <a             class="btn blue"             href="/new-post"           >             ➕ انتشار پست           </a>         </div>       `;     }      return sendHtml(       res,       200,       "خانه",       content,       user,       req     );   }    /* =====================================================      پست جدید   ===================================================== */    if (     method === "GET" &&     path === "/new-post"   ) {     return sendHtml(       res,       200,       "پست جدید",       `         <div class="card">            <h2>🚀 انتشار پست</h2>            <form             method="post"             action="/new-post"           >              <textarea               name="content"               placeholder="چه چیزی می‌خواهی منتشر کنی؟&#10;&#10;برای هشتگ مثلاً #خبر یا #دوستان"               required               maxlength="10000"             ></textarea>              <input               name="media_url"               type="url"               placeholder="لینک عکس یا ویدیو، اختیاری"             >              <button class="blue full">               🚀 انتشار             </button>            </form>          </div>       `,       user,       req     );   }    if (     method === "POST" &&     path === "/new-post"   ) {     const b = await readBody(req);      const content =       String(b.get("content") || "")         .trim()         .slice(0, 10000);      const media =       safeUrl(         b.get("media_url") || ""       );      if (content) {       await pool.query(         `           INSERT INTO posts           (             user_id,             content,             media_url           )           VALUES($1,$2,$3)         `,         [           user.id,           content,           media         ]       );     }      return redirect(res, "/");   }    /* =====================================================      لایک   ===================================================== */    if (     method === "POST" &&     path === "/like"   ) {     const id =       parseId(         url.searchParams.get("id")       );      if (!id) {       return redirect(res, "/");     }      const post = await pool.query(       `         SELECT user_id         FROM posts         WHERE id=$1       `,       [id]     );      if (!post.rowCount) {       return redirect(res, "/");     }      const existing =       await pool.query(         `           SELECT 1           FROM likes           WHERE user_id=$1             AND post_id=$2         `,         [user.id, id]       );      if (existing.rowCount) {       await pool.query(         `           DELETE FROM likes           WHERE user_id=$1             AND post_id=$2         `,         [user.id, id]       );     } else {       await pool.query(         `           INSERT INTO likes           (             user_id,             post_id           )           VALUES($1,$2)           ON CONFLICT DO NOTHING         `,         [user.id, id]       );        if (         post.rows[0].user_id !== user.id       ) {         await pool.query(           `             INSERT INTO notifications             (               user_id,               actor_id,               type,               post_id             )             VALUES($1,$2,'like',$3)           `,           [             post.rows[0].user_id,             user.id,             id           ]         );       }     }      return redirect(       res,       req.headers.referer || "/"     );   }    /* =====================================================      ذخیره پست   ===================================================== */    if (     method === "POST" &&     path === "/save"   ) {     const id =       parseId(         url.searchParams.get("id")       ); 