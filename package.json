            بازگشت  
          </a>  
        </div>  
      `,  
      user,  
      req  
    );  
  }  

  await pool.query(  
    `  
      UPDATE users  
      SET password=$1  
      WHERE id=$2  
    `,  
    [  
      hashPassword(newPassword),  
      user.id  
    ]  
  );  

  /*  
