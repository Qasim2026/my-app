k"   ) {     const id =       parseId(         url.searchParams.get("id")       );      if (       id &&       id !== user.id     ) {       await pool.query(         `           INSERT INTO blocks           (             blocker_id,             blocked_id           )           VALUES($1,$2)           ON CONFLICT DO NOTHING         `,         [user.id, id]       );        await pool.query(         `           DELETE FROM follows           WHERE             (               follower_id=$1               AND following_id=$2             )             OR             (               follower_id=$2               AND following_id=$1             )         `,         [user.id, id]       );     }      return redirect(       res,       `/user?id=${id}`     );   }    /* =====================================================      Unblock   ===================================================== */    if (     method === "POST" &&     path === "/unblock"   ) {     const id =       parseId(         url.searchParams.get("id")       );      if (id) {       await pool.query(         `           DELETE FROM blocks           WHERE blocker_id=$1             AND blocked_id=$2         `,         [user.id, id]       );     }      return redirect(       res,       `/user?id=${id}`     );   }    /* =====================================================      لیست کاربران مسدودشده   ===================================================== */    if (     method === "GET" &&     path === "/blocked"   ) {     const result =       await pool.query(         `           SELECT             u.id,             u.name,             u.email,             u.avatar_url            FROM blocks b            JOIN users u           ON u.id=b.blocked_id            WHERE b.blocker_id=$1            ORDER BY u.name         `,         [user.id]       ); ` `  let content = `       <div class="card">         <h2>🚫 کاربران مسدودشده</h2>       </div>     `;      for (const p of result.rows) {       content += `         <div class="c