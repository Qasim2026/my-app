        </div>  
      `,  
      user,  
      req  
    );  
  }  

  const check =  
    await pool.query(  
      `  
        SELECT password  
        FROM users  
        WHERE id=$1  
      `,  
      [user.id]if (  
    !check.rowCount ||  
    !verifyPassword(  
      oldPassword,  
      check.rows[0].password  
    )  
  ) {  
    return sendHtml(  
      res,  
      400,  
      "خطا",  
